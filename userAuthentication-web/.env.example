# ──────────────────────────────────────────────────────────────────────────────
# Template for a LOCAL, PERSONAL override file.
#
# Copy to .env.local (applies to every profile) or .env.dev.local /
# .env.prod.local (applies to one profile). All *.local files are gitignored.
#
# You do not need this file just to build — the committed profile files
# .env.dev and .env.prod already carry working defaults:
#
#     npm run dev          → profile dev   (.env.dev)
#     npm run build:dev    → profile dev   (.env.dev)
#     npm run build        → profile prod  (.env.prod)
#     npm run build:prod   → profile prod  (.env.prod)
#     npx vite build --mode <profile>      → .env.<profile>
#
# Precedence (later wins):
#     .env.<profile>  <  .env.local  <  .env.<profile>.local  <  shell/CI env
#
# Every VITE_* variable is inlined into the JavaScript bundle at build time and
# is PUBLIC — readable by anyone who loads the app. Never put a secret here.
#
# NOTE ON EMPTY VALUES: the code reads these with `??`, which only falls back
# when a variable is *undefined*. Declaring `VITE_PRODUCT_NAME=` here sets it to
# an empty string and the fallback will NOT apply. Either give a real value or
# omit the line entirely. (VITE_API_BASE_URL is the deliberate exception —
# empty means "same origin", which is what the dev proxy needs.)
# ──────────────────────────────────────────────────────────────────────────────

# ─── API Configuration ────────────────────────────────────────────────────────
# Base URL of the Java backend (no trailing slash).
#
# LOCAL DEVELOPMENT (default):
#   Leave empty. The Vite dev server proxies /auth-service/** → http://localhost:10009
#   automatically, so no cross-origin request is made and CORS is not an issue.
#
# REMOTE / PRODUCTION:
#   Set to the full backend origin, e.g. https://api.example.com
#   The backend must allow that origin in SecurityConfig.corsConfigurationSource().
#
VITE_API_BASE_URL=

# The product/tenant identifier required by every backend API call (productName field).
# Obtain the correct value from your backend administrator.
VITE_PRODUCT_NAME=default

# ─── Admin dashboard ──────────────────────────────────────────────────────────
# Set to "true" to force the admin dashboard (products, users, MFA) to use local
# mock data instead of calling the backend admin API. When left unset/false, the
# app calls the real endpoints and automatically falls back to mock data only if
# they return 404 (not yet implemented). A visible "mock data" banner is shown
# whenever mock data is in use.
VITE_ADMIN_MOCK=false

# ─── Development ──────────────────────────────────────────────────────────────
# Set to "true" to enable verbose API request/error logging in the browser console.
# Never enable in production.
VITE_DEBUG_API=false
