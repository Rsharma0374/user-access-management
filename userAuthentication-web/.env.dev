# ──────────────────────────────────────────────────────────────────────────────
# Profile: dev
#
# Loaded by:  vite --mode dev          (npm run dev)
#             vite build --mode dev    (npm run build:dev)
#
# Mirrors the `dev` Maven profile in userAuthentication-core.
#
# These values are COMMITTED and PUBLIC. Every VITE_* var is inlined into the
# JavaScript bundle at build time and is readable by anyone who loads the app —
# never put a secret, key or password here. Personal overrides belong in
# .env.dev.local (gitignored).
# ──────────────────────────────────────────────────────────────────────────────

# Empty on purpose: requests stay same-origin and the Vite dev server proxies
# /auth-service/** → http://localhost:10009 (see vite.config.js), so there is no
# cross-origin request and CORS never comes into play.
VITE_API_BASE_URL=http://localhost:10009

# Tenant/product identifier sent as `productName` on every backend call.
# Must be a real value — see the note in .env.example about empty values.
VITE_PRODUCT_NAME=super-admin

# Call the real admin API; it falls back to mock data on 404 and shows a banner.
VITE_ADMIN_MOCK=false

# Verbose API request/error logging in the browser console.
VITE_DEBUG_API=true
