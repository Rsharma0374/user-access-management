# ──────────────────────────────────────────────────────────────────────────────
# Profile: prod
#
# Loaded by:  vite build --mode prod   (npm run build  /  npm run build:prod)
#
# Mirrors the `prod` Maven profile in userAuthentication-core.
#
# These values are COMMITTED and PUBLIC. Every VITE_* var is inlined into the
# JavaScript bundle at build time and is readable by anyone who loads the app —
# never put a secret, key or password here. Deployment-specific overrides belong
# in .env.prod.local (gitignored) or in real CI environment variables, which
# take precedence over this file.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the Java backend. There is no dev proxy in a production build.
#
#   - Leave EMPTY if the SPA and the backend are served from the same origin
#     (e.g. a reverse proxy / gateway routes /auth-service/** to the backend).
#     Requests then stay relative and same-origin.
#
#   - Set to the full origin (e.g. https://api.example.com, no trailing slash)
#     if the backend lives elsewhere. That origin must also be allowed by the
#     backend's SecurityConfig.corsConfigurationSource().
#
VITE_API_BASE_URL=https://kong.guardianservices.in

# Tenant/product identifier sent as `productName` on every backend call.
# CONFIRM this with your backend administrator before deploying — a wrong value
# makes every API call fail. Must not be left empty (see .env.example).
VITE_PRODUCT_NAME=super-admin

# Never serve mock data from a production build.
VITE_ADMIN_MOCK=false

# Never log API payloads in production.
VITE_DEBUG_API=false
